# Funda Scraper Configuration
# Copy this file to .env and customize as needed

# Search Configuration
LOCATION=gemeente-amsterdam
DISTANCE=5
MAX_PRICE=450000
MIN_ROOMS=5
MIN_AREA=100

# Timing Configuration (in seconds)
FUNDA_SLEEP=3600    # 1 hour
PARARIUS_SLEEP=1800 # 30 minutes
HUISPEDIA_SLEEP=3600 # 1 hour

# Logging
LOG_DIR=/app/log

# Kanboard Configuration
KANBAN_URL=http://kanboard/jsonrpc.php
KANBAN_USERNAME=admin
KANBAN_PASSWORD=admin
KANBAN_PROJECT_ID=1
KANBAN_OWNER_ID=1
KANBAN_CREATOR_ID=1
